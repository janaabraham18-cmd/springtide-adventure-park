---
// The Springtide badge: the park's own logo (sun rays, hand-lettered
// "Spring Tide", waves) on its royal-blue disc. Vector-traced from the logo
// artwork into public/brand/; served as a file so it's cached, not inlined.
interface Props {
  size?: number;
  class?: string;
}
const { size = 40, class: className } = Astro.props;
---

<img
  class:list={['logo-mark', className]}
  src="/brand/logo-badge.svg"
  width={size}
  height={size}
  alt=""
  decoding="async"
/>

<style>
  .logo-mark {
    flex-shrink: 0;
    border-radius: 50%;
  }
</style>

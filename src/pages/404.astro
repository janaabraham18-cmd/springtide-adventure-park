---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout title="Page not found">
  <PageHero
    eyebrow="404"
    title="This page bounced away"
    accentWord="bounced"
    lede="The link may be old or mistyped. Try the home page or jump straight to booking."
    image="/images/foam-pit.jpg"
    compact
  >
    <div style="display:flex;flex-wrap:wrap;gap:.75rem">
      <a href="/" class="btn">Back to home</a>
      <a href="/booking" class="btn btn--ghost"><span>Book a jump</span></a>
    </div>
  </PageHero>
</BaseLayout>

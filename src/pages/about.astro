---
import BaseLayout from '../layouts/BaseLayout.astro';
import TideLine from '../components/TideLine.astro';
import { hl } from '../utils/text';
import { aboutIsPlaceholder, founders, pullQuote, story, values } from '../data/about';

// Polaroid layout: position (% of the scrapbook box), width, tilt, stacking.
const snapshots = [
  { src: '/images/climbing-wall.jpg', alt: 'The climbing wall rising out of the foam pit', caption: 'Climb high, drop soft', x: 1, y: 1, w: 45, r: -6, z: 2 },
  { src: '/images/party-starburst.jpg', alt: 'The boys’ party room with its starburst wall', caption: 'The boys’ room', x: 53, y: 0, w: 44, r: 5, z: 1 },
  { src: '/images/game-zone.jpg', alt: 'The Tap Tap Fun cube beside a game screen', caption: 'Tap Tap Fun', x: 27, y: 37, w: 46, r: -2, z: 5 },
  { src: '/images/party-jungle.jpg', alt: 'The girls’ party room with its jungle wall', caption: 'The girls’ room', x: 0, y: 63, w: 42, r: 4, z: 3 },
  { src: '/images/battle-beam.jpg', alt: 'The battle beam over the foam pit', caption: 'Last one standing', x: 56, y: 62, w: 42, r: -5, z: 4 },
];
---

<BaseLayout
  title="About Us"
  description="The story behind Springtide Adventure Park in Swakopmund — built by Anna and Milena, two mothers who wanted the children of our town to have somewhere to fly."
  image="/images/court-main.jpg"
>
  <!-- Scrapbook hero: the park's real photos as pinned polaroids on the logo's
       royal blue, with the logo's sun rays fanning out behind them. -->
  <section class="about-hero on-dark section--brand">
    <div class="about-hero__rays" aria-hidden="true"></div>
    <div class="container container--wide about-hero__grid">
      <div class="about-hero__text">
        <p class="eyebrow">About us</p>
        <h1 data-bounce set:html={hl('Two mothers, one big leap', 'leap')} />
        <p class="lede">
          We’re Anna and Milena — two mothers who built the place we wanted for our own children. Springtide is our
          love letter to every child in Swakopmund — and to every grown-up who still remembers how it felt to fly.
        </p>
      </div>

      <div class="scrapbook" aria-label="Snapshots from Springtide">
        {
          snapshots.map((s, i) => (
            <figure class="polaroid" data-drop style={`--x:${s.x}%;--y:${s.y}%;--w:${s.w}%;--r:${s.r}deg;--z:${s.z}`}>
              <div class="polaroid__card">
                <span class="polaroid__tape" aria-hidden="true" />
                <img src={s.src} alt={s.alt} loading={i < 3 ? 'eager' : 'lazy'} />
                <figcaption>{s.caption}</figcaption>
              </div>
            </figure>
          ))
        }
      </div>
    </div>
    <TideLine />
  </section>

  <section class="section story">
    <div class="container container--wide story__grid">
      <div class="story__aside" data-reveal>
        <p class="eyebrow">Our story</p>
        <h2 set:html={hl('Why we built Springtide', 'Springtide')} />
        <blockquote class="story__quote">
          <p>“{pullQuote}”</p>
        </blockquote>
        {aboutIsPlaceholder && <p class="draft-note">Draft — to be replaced with the founders’ own words</p>}
      </div>

      <div class="story__body">
        {story.map((para, i) => <p data-reveal class:list={{ 'story__lead': i === 0 }}>{para}</p>)}

        <figure class="story__photo" data-reveal>
          <img src="/images/lockers.jpg" alt="Colourful lockers and beanbags in the waiting corner at Springtide" loading="lazy" />
          <figcaption>The little corner where the waiting happens — and the coffee gets drunk.</figcaption>
        </figure>

        <div class="story__sign" data-reveal>
          <p class="story__sign-with">With love,</p>
          <p class="story__sign-names">{founders.join(' & ')}</p>
          <p class="story__sign-role">Founders, Springtide Adventure Park</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--brand values">
    <TideLine color="var(--color-blue-500)" flip />
    <div class="container container--wide">
      <div class="values__head" data-reveal>
        <p class="eyebrow">What we believe</p>
        <h2 set:html={hl('The promises we make to every family', 'promises')} />
      </div>
      <ul class="values__list" role="list">
        {
          values.map((v) => (
            <li data-reveal>
              <h3 set:html={hl(v.title, v.accentWord)} />
              <p>{v.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section about-cta">
    <TideLine flip />
    <div class="container container--wide about-cta__inner" data-reveal>
      <h2 set:html={hl('Come and jump with us', 'jump')} />
      <div class="about-cta__actions">
        <a href="/booking" class="btn">Book a jump</a>
        <a href="/party-rooms" class="btn btn--ink">Plan a party</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* SCRAPBOOK HERO */
  .about-hero {
    position: relative;
    padding-block: calc(var(--header-h) + var(--space-xl)) clamp(4.5rem, 9vw, 7rem);
    overflow: hidden;
    background: var(--color-blue-500);
    color: var(--color-on-dark);
    isolation: isolate;
  }

  /* The logo's sun: soft yellow glow plus rays fanning out from behind the
     photos. */
  .about-hero__rays {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 74% 52%, rgba(242, 211, 111, 0.38) 0, rgba(242, 211, 111, 0) 32%),
      repeating-conic-gradient(from 0deg at 74% 52%, rgba(255, 255, 255, 0.07) 0deg 5deg, transparent 5deg 15deg);
  }

  @media (max-width: 1023px) {
    .about-hero__rays {
      background:
        radial-gradient(circle at 50% 72%, rgba(242, 211, 111, 0.38) 0, rgba(242, 211, 111, 0) 40%),
        repeating-conic-gradient(from 0deg at 50% 72%, rgba(255, 255, 255, 0.07) 0deg 5deg, transparent 5deg 15deg);
    }
  }

  .about-hero__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .about-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: clamp(2rem, 4vw, 4rem);
      min-height: clamp(560px, 70svh, 760px);
    }
  }

  .about-hero__text {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
  }

  .about-hero h1 {
    max-width: 11ch;
    font-size: var(--fs-hero);
    line-height: 0.95;
  }

  .about-hero .lede {
    max-width: 32em;
  }

  .scrapbook {
    position: relative;
    width: 100%;
    max-width: 640px;
    aspect-ratio: 1 / 1.08;
    justify-self: center;
  }

  .polaroid {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    z-index: var(--z);
    margin: 0;
    transform: rotate(var(--r));
  }

  .polaroid__card {
    position: relative;
    padding: 4% 4% 0;
    background: #fdfcf8;
    border-radius: 3px;
    box-shadow:
      0 1px 2px rgba(10, 37, 64, 0.25),
      0 18px 40px -12px rgba(10, 37, 64, 0.55);
    transition:
      transform 0.45s var(--ease-spring),
      box-shadow 0.45s ease;
  }

  .polaroid:hover {
    z-index: 10;
  }

  .polaroid:hover .polaroid__card {
    transform: scale(1.06) rotate(calc(var(--r) * -1));
    box-shadow:
      0 1px 2px rgba(10, 37, 64, 0.25),
      0 30px 60px -14px rgba(10, 37, 64, 0.6);
  }

  .polaroid img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .polaroid figcaption {
    padding: 0.55em 0.2em 0.75em;
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 88%;
    font-size: clamp(0.72rem, 0.55rem + 0.6vw, 1rem);
    color: var(--color-ink-900);
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .polaroid__tape {
    position: absolute;
    top: -9px;
    left: 50%;
    width: 34%;
    height: 18px;
    transform: translateX(-50%) rotate(-3deg);
    background: rgba(242, 211, 111, 0.75);
    box-shadow: 0 1px 2px rgba(10, 37, 64, 0.15);
  }

  .story__grid {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 1024px) {
    .story__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(3rem, 7vw, 8rem);
      align-items: start;
    }
    .story__aside {
      position: sticky;
      top: calc(var(--header-h) + var(--space-lg));
    }
  }

  .story__aside {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
  }

  .story__quote {
    margin: var(--space-md) 0 0;
    padding-left: var(--space-md);
    border-left: 4px solid var(--color-purple-500);
  }

  .story__quote p {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 88%;
    font-size: var(--fs-xl);
    line-height: 1.25;
    color: var(--color-ink-900);
  }

  .story__body {
    display: grid;
    gap: var(--space-md);
    max-width: 40rem;
  }

  .story__body > p {
    font-size: var(--fs-lg);
    line-height: 1.7;
    color: var(--color-text);
  }

  .story__lead::first-letter {
    float: left;
    margin: 0.06em 0.12em 0 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 4.2em;
    line-height: 0.8;
    color: var(--color-blue-500);
  }

  .story__photo {
    margin: var(--space-md) 0;
  }

  .story__photo img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .story__photo figcaption {
    margin-top: var(--space-xs);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  .story__sign {
    margin-top: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-line);
  }

  .story__sign-with {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .story__sign-names {
    font-family: var(--font-display);
    font-weight: 750;
    font-stretch: 88%;
    font-size: var(--fs-2xl);
    line-height: 1.1;
    color: var(--color-purple-500);
  }

  .story__sign-role {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  .values {
    position: relative;
  }

  .values__head {
    display: grid;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .values__head h2 {
    max-width: 18ch;
  }

  .values__list {
    display: grid;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 700px) {
    .values__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .values__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .values__list li {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
    padding-top: var(--space-md);
    border-top: 2px solid rgba(246, 245, 241, 0.6);
  }

  .about-cta {
    position: relative;
  }

  .about-cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .about-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
</style>

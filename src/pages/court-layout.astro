---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CourtPlan from '../components/CourtPlan.astro';
import { hl } from '../utils/text';
import { zones } from '../data/zones';

const num = (i: number) => String(i + 1).padStart(2, '0');
---

<BaseLayout
  title="Court Layout"
  description="The Springtide floor plan — find the open jump court, dodgeball, slam dunk lanes, battle beam, bumper balls, climbing wall, café and party rooms."
  image="/images/court-foam.jpg"
>
  <PageHero
    eyebrow="Court layout"
    title="Find your way around"
    accentWord="way"
    lede="Every court, every zone and where to find the snacks. Tap a number on the plan to see what happens there."
    image="/images/court-foam.jpg"
    imageAlt="Springtide's trampoline courts running down to the foam pit"
    compact
  />

  <section class="section layout">
    <div class="container container--wide">
      <div class="layout__grid">
        <div class="layout__plan" data-reveal>
          <CourtPlan interactive />
          <p class="draft-note layout__note">Draft layout — positions to be redrawn from the park’s real floor plan</p>
        </div>

        <div class="layout__side">
          <nav class="layout__index" aria-label="Zones">
            <ul>
              {
                zones.map((z, i) => (
                  <li>
                    <a href={`#${z.id}`} data-zone-link={z.id} class:list={[`chip chip--${z.kind}`]}>
                      <span class="chip__num">{num(i)}</span>
                      {z.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <div class="zones" id="zone-panel" aria-live="polite" data-zones>
            {
              zones.map((z, i) => (
                <article class="zone-card" id={z.id} data-zone-card={z.id}>
                  <div class="zone-card__media">
                    <img src={z.image} alt={z.imageAlt} loading="lazy" />
                    <span class="zone-card__num">{num(i)}</span>
                  </div>
                  <div class="zone-card__body">
                    <p class="eyebrow">{z.kind === 'play' ? 'Play zone' : 'Facilities'}</p>
                    <h2 set:html={hl(z.name, z.accentWord)} />
                    <p class="zone-card__blurb">{z.blurb}</p>
                    <ul class="zone-card__details">
                      {z.details.map((d) => <li>{d}</li>)}
                    </ul>
                    {z.link && (
                      <a href={z.link.href} class="text-link">
                        {z.link.label}
                      </a>
                    )}
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt layout-cta">
    <div class="container container--wide layout-cta__inner" data-reveal>
      <h2 set:html={hl('Seen enough? Come and jump.', 'jump')} />
      <div class="layout-cta__actions">
        <a href="/booking" class="btn">Book a jump</a>
        <a href="/party-rooms" class="btn btn--ink">Book a party</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const zonesEl = document.querySelector<HTMLElement>('[data-zones]');
  const plan = document.querySelector<SVGElement>('.court-plan--interactive svg');

  if (zonesEl && plan) {
    zonesEl.classList.add('zones--panel');
    const groups = Array.from(plan.querySelectorAll<SVGGElement>('.zone'));
    const cards = Array.from(zonesEl.querySelectorAll<HTMLElement>('[data-zone-card]'));
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-zone-link]'));
    const ids = cards.map((c) => c.dataset.zoneCard!);

    const select = (id: string, opts: { scroll?: boolean; push?: boolean } = {}) => {
      if (!ids.includes(id)) return;
      groups.forEach((g) => {
        const on = g.dataset.zone === id;
        g.classList.toggle('is-active', on);
        g.classList.toggle('is-dim', !on);
        g.setAttribute('aria-pressed', String(on));
      });
      cards.forEach((c) => c.classList.toggle('is-active', c.dataset.zoneCard === id));
      links.forEach((l) => {
        const on = l.dataset.zoneLink === id;
        l.classList.toggle('is-active', on);
        if (on) l.setAttribute('aria-current', 'true');
        else l.removeAttribute('aria-current');
      });
      if (opts.push) history.replaceState(null, '', `#${id}`);
      // On narrow screens the card sits below the plan — bring it into view.
      if (opts.scroll && window.matchMedia('(max-width: 1099px)').matches) {
        zonesEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };

    groups.forEach((g) => {
      const id = g.dataset.zone!;
      g.addEventListener('click', () => select(id, { scroll: true, push: true }));
      g.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          select(id, { scroll: true, push: true });
        }
      });
    });

    links.forEach((l) =>
      l.addEventListener('click', (e) => {
        e.preventDefault();
        select(l.dataset.zoneLink!, { push: true });
      }),
    );

    const fromHash = location.hash.slice(1);
    select(ids.includes(fromHash) ? fromHash : ids[0]);
    window.addEventListener('hashchange', () => select(location.hash.slice(1)));
  }
</script>

<style>
  .layout__grid {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 1100px) {
    .layout__grid {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
      gap: clamp(2rem, 4vw, 4rem);
      align-items: start;
    }
    .layout__plan {
      position: sticky;
      top: calc(var(--header-h) + var(--space-md));
    }
  }

  .layout__note {
    margin-top: var(--space-sm);
  }

  .layout__index ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 var(--space-lg);
    padding: 0;
    list-style: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 40px;
    padding: 0.35em 0.9em 0.35em 0.4em;
    border: 1.5px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .chip:hover {
    border-color: var(--color-ink-900);
  }

  .chip__num {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--color-ink-900);
    color: var(--color-on-dark);
    font-size: var(--fs-xs);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .chip.is-active {
    border-color: var(--color-blue-500);
    background: rgba(1, 113, 185, 0.08);
  }

  .chip.is-active .chip__num {
    background: var(--color-blue-500);
  }

  .zones {
    display: grid;
    gap: var(--space-xl);
    scroll-margin-top: calc(var(--header-h) + var(--space-md));
  }

  .zones--panel .zone-card:not(.is-active) {
    display: none;
  }

  .zones--panel .zone-card.is-active {
    animation: card-in 0.5s var(--ease-out);
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .zone-card {
    scroll-margin-top: calc(var(--header-h) + var(--space-md));
  }

  .zone-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-sand-200);
  }

  .zone-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .zone-card__num {
    position: absolute;
    left: var(--space-md);
    bottom: var(--space-md);
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-blue-500);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-lg);
  }

  .zone-card__body {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
    padding-top: var(--space-lg);
  }

  .zone-card__blurb {
    font-size: var(--fs-lg);
    color: var(--color-text-muted);
  }

  .zone-card__details {
    display: grid;
    gap: 0.4rem;
    margin: var(--space-xs) 0 var(--space-sm);
    padding: 0;
    list-style: none;
  }

  .zone-card__details li {
    position: relative;
    padding-left: 1.6rem;
  }

  .zone-card__details li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.9rem;
    height: 0.45rem;
    border-bottom: 2px solid var(--color-blue-500);
    border-radius: 0 0 50% 50%;
  }

  .layout-cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .layout-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
</style>

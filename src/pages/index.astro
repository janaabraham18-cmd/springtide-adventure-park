---
import BaseLayout from '../layouts/BaseLayout.astro';
import TideLine from '../components/TideLine.astro';
import { hl } from '../utils/text';
import { gripSocksPrice, holidayNote, hours, hoursArePlaceholder, money, rates, site } from '../data/site';
import { zones } from '../data/zones';

// Spelled out so the heading follows the zone list as zones are added or removed.
const countWord = (n: number) =>
  ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'][n] ?? String(n);
const rateCards = [
  { title: 'Midweek jumps', days: 'Tuesday – Thursday', key: 'weekday' as const, dark: false },
  { title: 'Weekend jumps', days: 'Friday – Sunday', key: 'weekend' as const, dark: true },
];

const zoneNumber = (i: number) => String(i + 1).padStart(2, '0');

const rules = [
  {
    title: 'Book your slot',
    accentWord: 'slot',
    body: 'Sessions are capped so the courts never get crowded. Book online and walk straight in.',
  },
  {
    title: 'Grip socks on',
    accentWord: 'Grip',
    body: 'Everyone on the courts wears Springtide grip socks. Bring last visit’s pair, or grab a new one at reception for N$45.',
  },
  {
    title: 'Sign the waiver',
    accentWord: 'waiver',
    body: 'One waiver per jumper, signed by a parent or guardian for under-18s. It takes two minutes at check-in.',
  },
  {
    title: 'Arrive 15 minutes early',
    accentWord: 'early',
    body: 'Time to check in, stash your shoes and hear the quick safety briefing from a marshal.',
  },
];
---

<BaseLayout>
  <!-- HERO: a giant JUMP with the park showing through the letters -->
  <section class="hero on-dark section--brand">
    <div class="hero__glow" aria-hidden="true"></div>

    <div class="container container--wide hero__content">
      <p class="eyebrow">Trampoline &amp; adventure park · {site.town}</p>
      <h1 class="hero__title">
        <span
          class="hero__jump"
          role="img"
          aria-label="Jump"
          style="background-image: url('/images/battle-beam.jpg')">Jump</span>
        <span class="hero__rest" set:html={hl('higher than the tide.', 'higher')} />
      </h1>
      <p class="lede">
        Wall-to-wall trampolines, dodgeball, slam dunk lanes, a battle beam over a foam pit, bumper balls and a
        climbing wall — with milkshakes and pizza waiting when you land.
      </p>
      <div class="hero__actions">
        <a href="/booking" class="btn">
          Book a jump
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
        <a href="/about" class="btn btn--ghost"><span>Our story</span></a>
      </div>
    </div>

    <p class="hero__today" data-today hidden></p>

    <TideLine />
  </section>

  <!-- WHAT'S INSIDE -->
  <section class="section inside">
    <div class="container container--wide inside__grid">
      <div class="inside__intro" data-reveal>
        <p class="eyebrow">What’s inside</p>
        <h2 set:html={hl(`${countWord(zones.length)} ways to leave the ground`, 'ground')} />
        <p class="lede">
          Every zone has its own marshal and its own rules, so first-timers and flip fanatics can share the same
          building.
        </p>
        <a href="/booking" class="text-link">Book your session</a>
      </div>

      <ol class="inside__list">
        {
          zones.map((z, i) => (
            <li class="inside__item" data-reveal>
              <div class="inside__link" id={z.id}>
                <span class="inside__num">{zoneNumber(i)}</span>
                <span class="inside__text">
                  <h3 set:html={hl(z.name, z.accentWord)} />
                  <span class="inside__blurb">{z.blurb}</span>
                </span>
                <span class="inside__thumb">
                  <img src={z.image} alt={z.imageAlt} loading="lazy" />
                </span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- OUR STORY TEASER -->
  <section class="section section--brand story-teaser">
    <TideLine color="var(--color-blue-500)" flip />
    <div class="container container--wide story-teaser__grid">
      <div class="story-teaser__text" data-reveal>
        <p class="eyebrow">Our story</p>
        <h2 set:html={hl('Made with love, right here in Swakopmund', 'love')} />
        <p class="lede">
          Springtide Adventure Park was built by two mothers, Anna and Milena, with one simple wish: that their children, and every
          child in our town, would always have somewhere to be wild, loud and gloriously free — fog or no fog.
        </p>
        <a href="/about" class="btn">Read our story</a>
      </div>
      <figure class="story-teaser__photo" data-reveal>
        <img src="/images/climbing-wall.jpg" alt="The colourful climbing wall rising out of the foam pit" loading="lazy" />
      </figure>
    </div>
  </section>

  <!-- CAFÉ + PARTIES -->
  <section class="section duo">
    <TideLine flip />
    <div class="container container--wide duo__grid">
      <a href="/cafe" class="duo__panel on-dark" data-reveal>
        <img
          class="photo-bg"
          src="/images/cafe-counter.jpg"
          alt="The café counter under round blue ceiling panels and pendant lights, with tables alongside"
          style="object-position: center 35%"
          loading="lazy"
        />
        <span class="duo__scrim" aria-hidden="true"></span>
        <span class="duo__body">
          <span class="eyebrow">The café</span>
          <h2 set:html={hl('Refuel between sessions', 'Refuel')} />
          <span class="duo__copy">Thick shakes, slushies, toasties, pizza and proper coffee for the grown-ups.</span>
          <span class="duo__cta">See the menu →</span>
        </span>
      </a>

      <a href="/party-rooms" class="duo__panel on-dark" data-reveal>
        <img class="photo-bg" src="/images/party-jungle.jpg" alt="The girls’ party room, with a long wooden table in front of a tropical leaf wall" loading="lazy" />
        <span class="duo__scrim" aria-hidden="true"></span>
        <span class="duo__body">
          <span class="eyebrow">Party rooms</span>
          <h2 set:html={hl('Birthdays that bounce', 'bounce')} />
          <span class="duo__copy">A private room, a party host and court time for the whole crew. You bring the cake.</span>
          <span class="duo__cta">Plan a party →</span>
        </span>
      </a>
    </div>
  </section>

  <!-- TIDE TABLE: passes + hours -->
  <section class="section section--purple tide">
    <TideLine color="var(--color-purple-500)" flip />
    <div class="container container--wide">
      <div class="tide__head" data-reveal>
        <p class="eyebrow">Tide table</p>
        <h2 set:html={hl('Jump rates and opening hours', 'rates')} />
        {hoursArePlaceholder && <p class="draft-note">Draft — hours to be confirmed by the park</p>}
      </div>

      <div class="tide__grid">
        <div class="tide__rates">
          <ul class="tide__passes" role="list">
            {
              rateCards.map((card) => (
                <li class:list={['pass', { 'pass--featured': card.dark }]} data-reveal>
                  <h3 set:html={hl(card.title, 'jumps')} />
                  <p class="pass__days">{card.days}</p>
                  <dl class="pass__rates">
                    {rates.map((r) => (
                      <div>
                        <dt>{r.name}</dt>
                        <dd>{money(r[card.key])}</dd>
                      </div>
                    ))}
                  </dl>
                </li>
              ))
            }
          </ul>
          <p class="tide__socks" data-reveal>
            <strong>Grip socks {money(gripSocksPrice)}</strong> — everyone on the courts wears them. Already have a
            Springtide pair? Bring them along.
          </p>
          <a href="/booking" class="btn" data-reveal>Book a jump</a>
        </div>

        <div class="tide__hours" data-reveal>
          <h3 set:html={hl('When the tide is in', 'tide')} />
          <dl>
            {
              hours.map((h, i) => (
                <div data-day={i}>
                  <dt>{h.day}</dt>
                  <dd>{h.open ? `${h.open} – ${h.close}` : 'Closed'}</dd>
                </div>
              ))
            }
          </dl>
          <p class="tide__small">{holidayNote}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- BEFORE YOU JUMP -->
  <section class="section rules">
    <TideLine flip />
    <div class="container container--wide">
      <div class="rules__head" data-reveal>
        <p class="eyebrow">Before you jump</p>
        <h2 set:html={hl('Four things for a smooth landing', 'landing')} />
      </div>
      <ol class="rules__list">
        {
          rules.map((r, i) => (
            <li data-reveal>
              <span class="rules__num">{i + 1}</span>
              <h3 set:html={hl(r.title, r.accentWord)} />
              <p>{r.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- VISIT -->
  <section class="visit on-dark">
    <img class="photo-bg" src="/images/swakop-evening.jpg" alt="Swakopmund's coastline at sunset" loading="lazy" />
    <div class="visit__scrim" aria-hidden="true"></div>
    <TideLine hang />
    <div class="container container--wide visit__content" data-reveal>
      <p class="eyebrow">Find us in {site.town}</p>
      <h2 set:html={hl('The next spring tide is yours', 'spring')} />
      <p class="lede">{site.contact.street}, {site.contact.area}</p>
      <div class="hero__actions">
        <a href="/booking" class="btn">Book a jump</a>
        <a href="/contact" class="btn btn--ghost"><span>Directions &amp; contact</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { hours } from '../data/site';

  // "Open today" chip in the hero + highlight today's row in the hours table.
  const jsDay = new Date().getDay(); // 0 = Sunday
  const idx = (jsDay + 6) % 7; // Monday-first index into `hours`
  const today = hours[idx];
  const chip = document.querySelector<HTMLElement>('[data-today]');
  if (chip && today) {
    chip.innerHTML = today.open
      ? `<span class="dot dot--open"></span>Open today ${today.open} – ${today.close}`
      : `<span class="dot"></span>Closed today`;
    chip.hidden = false;
  }
  document.querySelector(`[data-day="${idx}"]`)?.classList.add('is-today');
</script>

<style>
  /* HERO */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(2rem, 6vh, 4.5rem);
    min-height: 100svh;
    padding-block: calc(var(--header-h) + clamp(1.5rem, 4vh, 3rem)) clamp(4.5rem, 8vw, 7rem);
    overflow: hidden;
    color: var(--color-on-dark);
    isolation: isolate;
  }

  /* A low sun glow behind the word and a teal swell at the bottom, on the brand blue. */
  .hero__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 60% 45% at 50% 30%, rgba(242, 211, 111, 0.3), transparent 70%),
      radial-gradient(ellipse 80% 40% at 50% 100%, rgba(70, 188, 201, 0.4), transparent 70%);
  }

  .hero__content {
    display: grid;
    gap: var(--space-md);
    justify-items: center;
    text-align: center;
    /* The giant word is sized off this box's width (cqi), so it fills the
       container at every screen size without overflowing. */
    container-type: inline-size;
  }

  .hero__title {
    display: grid;
    justify-items: center;
    gap: 0.1em;
    margin: 0;
  }

  /* The park photo, clipped to the letters of JUMP, with a white edge so the
     letters stay crisp where the photo is blue too. It drifts slowly. */
  .hero__jump {
    display: inline-block;
    /* "JUMP" is ~1.79em wide, so 53cqi fills ~95% of the row; the svh cap keeps
       the whole hero on one laptop screen. */
    font-size: min(53cqi, 46svh);
    font-weight: 800;
    font-stretch: 78%;
    line-height: 0.82;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: transparent;
    background-size: 135% auto;
    background-position: 30% 45%;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    /* White edge built from four hard drop-shadows (text-stroke shows the
       font's internal contour seams), then the soft lift shadow. */
    --edge: 3px;
    filter: drop-shadow(var(--edge) 0 0 #fff) drop-shadow(calc(-1 * var(--edge)) 0 0 #fff)
      drop-shadow(0 var(--edge) 0 #fff) drop-shadow(0 calc(-1 * var(--edge)) 0 #fff)
      drop-shadow(0 18px 30px rgba(10, 37, 64, 0.45));
    padding: 0.04em 0.02em 0;
    animation:
      jump-in 1.1s cubic-bezier(0.2, 0.8, 0.25, 1.15) 0.1s both,
      jump-pan 20s ease-in-out 1.2s infinite alternate;
  }

  @media (max-width: 600px) {
    .hero__jump {
      --edge: 2px;
    }
  }

  .hero__rest {
    display: block;
    font-size: clamp(2rem, 1rem + 3.6vw, 4.75rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    animation: rest-in 0.8s cubic-bezier(0.2, 0.7, 0.3, 1) 0.55s both;
  }

  @keyframes jump-in {
    from {
      opacity: 0;
      transform: translateY(18%) scale(0.92);
    }
  }

  @keyframes jump-pan {
    to {
      background-position: 70% 65%;
    }
  }

  @keyframes rest-in {
    from {
      opacity: 0;
      transform: translateY(0.4em);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__jump,
    .hero__rest {
      animation-name: none;
    }
  }

  .hero .lede {
    max-width: 36em;
  }

  /* The eyebrow's leading rule reads oddly once the centred label wraps. */
  @media (max-width: 600px) {
    .hero .eyebrow::before {
      display: none;
    }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }

  .hero__today {
    position: absolute;
    /* Line up with the header's right edge (the wide container), not the viewport. */
    right: max(var(--gutter), (100% - var(--container-wide)) / 2 + var(--gutter));
    top: calc(var(--header-h) + var(--space-md));
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    margin: 0;
    padding: 0.5em 1em;
    border: 1px solid rgba(246, 245, 241, 0.35);
    border-radius: var(--radius-pill);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-on-dark);
    background: rgba(10, 37, 64, 0.25);
  }

  .hero__today :global(.dot) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-sand-300);
  }

  .hero__today :global(.dot--open) {
    background: #5ee08f;
    box-shadow: 0 0 0 4px rgba(94, 224, 143, 0.25);
  }

  /* Below the laptop range the chip would sit on the headline: move it into
     the flow, under the buttons. */
  @media (max-width: 1279px) {
    .hero__today {
      position: static;
      align-self: center;
      order: 1;
      margin-top: calc(var(--space-md) - clamp(2rem, 6vh, 4.5rem));
    }
  }

  /* WHAT'S INSIDE */
  .inside__grid {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 1024px) {
    .inside__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr);
      gap: clamp(3rem, 6vw, 7rem);
      align-items: start;
    }
    .inside__intro {
      position: sticky;
      top: calc(var(--header-h) + var(--space-lg));
    }
  }

  .inside__intro {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
  }

  .inside__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .inside__item {
    border-bottom: 1px solid var(--color-line);
  }

  .inside__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-md);
    align-items: start;
    padding-block: var(--space-lg);
    text-decoration: none;
  }

  @media (min-width: 640px) {
    .inside__link {
      grid-template-columns: 3.5rem minmax(0, 1fr) clamp(110px, 14vw, 170px);
      gap: var(--space-lg);
    }
  }

  .inside__num {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 88%;
    font-size: var(--fs-lg);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    padding-top: 0.2em;
  }

  .inside__text {
    display: grid;
    gap: 0.5rem;
  }

  .inside__text h3 {
    font-size: clamp(1.6rem, 1.1rem + 1.6vw, 2.4rem);
    transition: transform 0.45s var(--ease-spring);
  }

  .inside__blurb {
    color: var(--color-text-muted);
    max-width: 40em;
  }

  .inside__thumb {
    display: none;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  @media (min-width: 640px) {
    .inside__thumb {
      display: block;
    }
  }

  .inside__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .inside__link:hover h3 {
    transform: translateX(6px);
  }

  .inside__link:hover .inside__thumb img {
    transform: scale(1.07);
  }

  /* STORY TEASER */
  .story-teaser {
    position: relative;
  }

  .story-teaser__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .story-teaser__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 6rem);
    }
  }

  .story-teaser__text {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
  }

  .story-teaser__text h2 {
    max-width: 16ch;
  }

  .story-teaser__photo {
    margin: 0;
  }

  .story-teaser__photo img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 80px -30px rgba(10, 37, 64, 0.6);
  }

  /* DUO */
  .duo {
    position: relative;
  }

  .duo__grid {
    display: grid;
    gap: var(--space-md);
  }

  @media (min-width: 900px) {
    .duo__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .duo__panel {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(420px, 60vw, 640px);
    padding: clamp(1.5rem, 3vw, 2.75rem);
    overflow: hidden;
    border-radius: var(--radius-lg);
    color: var(--color-on-dark);
    text-decoration: none;
    isolation: isolate;
  }

  @media (min-width: 900px) {
    .duo__panel {
      min-height: clamp(480px, 42vw, 640px);
    }
  }

  .duo__panel .photo-bg {
    z-index: -2;
    transition: transform 0.9s var(--ease-out);
  }

  .duo__panel:hover .photo-bg {
    transform: scale(1.05);
  }

  .duo__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgba(10, 37, 64, 0.9) 0%, rgba(10, 37, 64, 0.5) 40%, rgba(10, 37, 64, 0) 80%);
  }

  .duo__body {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
  }

  .duo__body h2 {
    max-width: 12ch;
    text-shadow: 0 2px 20px rgba(10, 37, 64, 0.4);
  }

  .duo__copy {
    max-width: 30em;
    color: var(--color-on-dark-muted);
    text-shadow: 0 1px 10px rgba(10, 37, 64, 0.5);
  }

  .duo__cta {
    margin-top: var(--space-xs);
    font-weight: 700;
    border-bottom: 2px solid var(--color-yellow-400);
    padding-bottom: 2px;
  }

  /* TIDE TABLE */
  .tide {
    position: relative;
  }

  .tide__head {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
    margin-bottom: var(--space-xl);
  }

  .tide__grid {
    display: grid;
    gap: var(--space-lg);
  }

  @media (min-width: 1100px) {
    .tide__grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .tide__rates {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
  }

  .tide__passes {
    display: grid;
    gap: var(--space-md);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 700px) {
    .tide__passes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .pass {
    /* Light card on the purple section: back to the light-background tones. */
    --accent-1: var(--color-purple-500);
    --accent-2: var(--color-blue-500);
    display: grid;
    gap: 0.35rem;
    align-content: start;
    padding: var(--space-lg);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    box-shadow: 0 24px 50px -28px rgba(10, 37, 64, 0.55);
  }

  .pass--featured {
    /* Dark card inside a light section: the dark-background tones. */
    --accent-1: var(--color-lilac-300);
    --accent-2: var(--color-blue-300);
    background: var(--color-ink-900);
    color: var(--color-on-dark);
  }

  .pass__days {
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .pass--featured .pass__days {
    color: var(--color-on-dark-muted);
  }

  .pass__rates {
    display: grid;
    gap: 0.6rem;
    margin: var(--space-md) 0 0;
  }

  .pass__rates div {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    column-gap: 0.6rem;
  }

  .pass__rates div::after {
    content: '';
    grid-column: 2;
    grid-row: 1;
    border-bottom: 2px dotted currentColor;
    opacity: 0.3;
    transform: translateY(-0.3em);
  }

  .pass__rates dt {
    grid-column: 1;
    font-weight: 600;
  }

  .pass__rates dd {
    grid-column: 3;
    margin: 0;

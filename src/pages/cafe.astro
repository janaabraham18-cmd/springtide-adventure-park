---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import TideLine from '../components/TideLine.astro';
import { hl } from '../utils/text';
import { favourites, menu, menuFootnote, menuIsPlaceholder } from '../data/cafe';
---

<BaseLayout
  title="Café"
  description="Thick shakes, slushies, toasties, pizza and coffee at the Springtide Adventure Park café in Swakopmund."
  image="/images/cafe-seating.jpg"
>
  <PageHero
    eyebrow="The café"
    title="Land here between jumps"
    accentWord="Land"
    lede="Shakes, slushies, toasties and pizza for the jumpers. Proper coffee for whoever’s watching."
    image="/images/cafe-seating.jpg"
    imageAlt="The Springtide Adventure Park café: white chairs and wooden tables up on the mezzanine, looking out over the trampoline courts"
    focus="center 55%"
    compact
  />

  <section class="section cafe-intro">
    <div class="container container--wide">
      <div class="cafe-intro__grid">
        <div class="cafe-intro__text" data-reveal>
          <p class="eyebrow">Open whenever the park is</p>
          <h2 set:html={hl('Fuel for the next session', 'Fuel')} />
          <p class="lede">
            Order at the counter, grab a table and keep an eye on the courts. Everything’s made to be eaten quickly and
            shared easily, because nobody wants to sit out for long.
          </p>
        </div>
        <!-- The real café: the counter, and a table looking out over the courts -->
        <div class="cafe-intro__photos">
          <img
            src="/images/cafe-counter.jpg"
            alt="The café counter under round blue ceiling panels and pendant lights, with tables alongside"
            loading="lazy"
            class="cafe-intro__a"
            data-reveal
          />
          <img
            src="/images/cafe-courtside.jpg"
            alt="A café table and chairs at the railing, looking down on the trampolines and the Tap Tap Fun game zone"
            loading="lazy"
            class="cafe-intro__b"
            data-reveal
          />
        </div>
      </div>

      <!-- Favourites: the signature items, big and photographed, before the full menu -->
      <ul class="faves" aria-label="Café favourites">
        {
          favourites.map((f) => (
            <li class="fave" data-reveal>
              <div class="fave__photo">
                <img src={f.image} alt={f.imageAlt} loading="lazy" />
                <span class="fave__price">{f.price}</span>
              </div>
              <div class="fave__text">
                <h3 set:html={hl(f.title, f.accentWord)} />
                <p>{f.blurb}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--purple menu">
    <TideLine color="var(--color-purple-500)" flip />
    <div class="container container--wide">
      <div class="menu__head" data-reveal>
        <p class="eyebrow">Menu</p>
        <h2 set:html={hl('What’s on the board', 'board')} />
        {menuIsPlaceholder && <p class="draft-note">Draft menu — items and prices to be confirmed by the park</p>}
      </div>

      <div class="menu__grid">
        {
          menu.map((section) => (
            <section
              class:list={['menu__section', { 'menu__section--photo': section.image }]}
              data-reveal
              aria-labelledby={`menu-${section.id}`}
            >
              {section.image && <img class="menu__photo" src={section.image} alt={section.imageAlt} loading="lazy" />}
              <h3 id={`menu-${section.id}`} set:html={hl(section.title, section.accentWord)} />
              {section.note && <p class="menu__note">{section.note}</p>}
              <ul>
                {section.items.map((item) => (
                  <li>
                    <span class="menu__name">{item.name}</span>
                    {item.price && (
                      <>
                        <span class="menu__leader" aria-hidden="true" />
                        <span class="menu__price">{item.price}</span>
                      </>
                    )}
                    {item.desc && <span class="menu__desc">{item.desc}</span>}
                    {item.flavours && (
                      <span class="menu__flavours">
                        {item.flavours.map((f) => (
                          <span class="flavour">
                            <span
                              class:list={['flavour__dot', { 'flavour__dot--cookies': f.color === 'cookies' }]}
                              style={f.color === 'cookies' ? undefined : `--dot: ${f.color}`}
                              aria-hidden="true"
                            />
                            {f.name}
                          </span>
                        ))}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
      <p class="menu__footnote" data-reveal>
        {menuFootnote} <a href="/party-rooms" class="text-link">See our party rooms</a>
      </p>
    </div>
  </section>

  <!-- SEATS WITH A VIEW -->
  <section class="section view">
    <TideLine flip />
    <div class="container container--wide">
      <div class="view__head" data-reveal>
        <p class="eyebrow">Seats with a view</p>
        <h2 set:html={hl('Every table looks out over the courts', 'courts')} />
        <p class="lede">
          The café sits up above the trampolines, so you can sip a coffee and still catch every flip, dunk and
          dodgeball win.
        </p>
      </div>
      <div class="view__grid">
        <img
          src="/images/cafe-tables.jpg"
          alt="Rows of café tables along the wooden railing, with the courts and game zone below"
          loading="lazy"
          class="view__wide"
          data-reveal
        />
        <img
          src="/images/court-net.jpg"
          alt="The trampoline courts seen through the safety netting, with the orange battle beam and yellow-edged beds"
          loading="lazy"
          data-reveal
        />
        <img
          src="/images/cafe-mezzanine.jpg"
          alt="White chairs and wooden tables on the mezzanine, with the climbing wall in the background"
          loading="lazy"
          data-reveal
        />
      </div>
    </div>
  </section>

  <section class="section cafe-cta">
    <div class="container container--wide cafe-cta__inner" data-reveal>
      <img
        src="/images/cafe-table-sign.jpg"
        alt="A Springtide table number sign reading Table 2 on a café table"
        loading="lazy"
        class="cafe-cta__photo"
      />
      <div class="cafe-cta__text">
        <h2 set:html={hl('Shakes taste better after a battle beam win', 'battle')} />
        <a href="/booking" class="btn">Book a jump</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cafe-intro__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .cafe-intro__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 6rem);
    }
  }

  .cafe-intro__text {
    display: grid;
    gap: var(--space-md);
    max-width: 44rem;
  }

  /* Counter (portrait) behind, courtside table (landscape) overlapping it. */
  .cafe-intro__photos {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: start;
  }

  .cafe-intro__photos img {
    width: 100%;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .cafe-intro__a {
    grid-column: 1 / span 6;
    grid-row: 1;
    aspect-ratio: 3 / 4;
  }

  .cafe-intro__b {
    grid-column: 5 / span 8;
    grid-row: 1;
    margin-top: 38%;
    aspect-ratio: 4 / 3;
    border: 6px solid var(--color-bg);
    box-shadow: 0 20px 50px -20px rgba(10, 37, 64, 0.4);
  }

  /* FAVOURITES */
  .faves {
    display: grid;
    gap: var(--space-lg);
    margin: clamp(2.5rem, 5vw, 4.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 600px) {
    .faves {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .faves {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: clamp(1.25rem, 2vw, 2rem);
    }
  }

  /* Phones: photo beside the text, so four favourites don't become four
     full-screen photos in a row. */
  .fave {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-md);
    align-items: start;
  }

  @media (min-width: 600px) {
    .fave {
      grid-template-columns: 1fr;
    }
  }

  .fave__photo {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    box-shadow: 0 22px 40px -26px rgba(10, 37, 64, 0.55);
  }

  .fave__photo img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: scale 0.6s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .fave:hover .fave__photo img {
    scale: 1.05;
  }

  /* Price as a sticker on the photo's corner. */
  .fave__price {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    padding: 0.35em 0.8em;
    border-radius: var(--radius-pill);
    font-weight: 800;
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-900);
    background: var(--color-yellow-400);
    rotate: -4deg;
    box-shadow: 0 6px 14px -6px rgba(10, 37, 64, 0.5);
  }

  .fave__text {
    display: grid;
    gap: var(--space-xs);
  }

  @media (min-width: 600px) {
    .fave__text {
      margin-top: var(--space-md);
    }
  }

  .fave h3 {
    font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.6rem);
  }

  .fave p {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  .menu {
    position: relative;
  }

  .menu__head {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
    margin-bottom: var(--space-xl);
  }

  .menu__grid {
    columns: 1;
    column-gap: clamp(2rem, 5vw, 5rem);
  }

  @media (min-width: 800px) {
    .menu__grid {
      columns: 2;
    }
  }

  @media (min-width: 1280px) {
    .menu__grid {
      columns: 3;
    }
  }

  /* Each menu section is a card; sections with a photo show it full-bleed
     across the card's top. */
  .menu__section {
    /* Light card on the coloured menu section: back to the light-background
       text and accent tones. */
    --accent-1: var(--color-purple-500);
    --accent-2: var(--color-blue-500);
    --pad: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    color: var(--color-text);
    break-inside: avoid;
    margin-bottom: clamp(1.25rem, 2vw, 2rem);
    padding: var(--pad);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    box-shadow: 0 24px 50px -28px rgba(10, 37, 64, 0.6);
  }

  .menu__photo {
    display: block;
    width: calc(100% + 2 * var(--pad));
    max-width: none;
    margin: calc(-1 * var(--pad)) calc(-1 * var(--pad)) var(--space-md);
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center 35%;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  .menu__note {
    margin-top: var(--space-xs);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  .menu__section ul {
    display: grid;
    gap: var(--space-sm);
    margin: var(--space-md) 0 0;
    padding: 0;
    list-style: none;
  }

  .menu__section li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    column-gap: 0.6rem;
  }

  .menu__footnote {
    margin-top: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 2px solid rgba(246, 245, 241, 0.4);
    font-weight: 600;
  }

  .menu__name {
    font-weight: 700;
  }

  .menu__leader {
    border-bottom: 2px dotted var(--color-sand-300);
    transform: translateY(-0.3em);
  }

  .menu__price {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .menu__desc {
    grid-column: 1 / -1;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  /* Milkshake flavours as colour dots. */
  .menu__flavours {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    margin-top: 0.3rem;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  .flavour {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .flavour__dot {
    width: 0.95em;
    height: 0.95em;
    border-radius: 50%;
    background: var(--dot);
    box-shadow: inset 0 0 0 1px rgba(10, 37, 64, 0.2);
  }

  /* Cookies & cream: cream with cookie crumbs. */
  .flavour__dot--cookies {
    background:
      radial-gradient(circle at 30% 32%, #2b1d16 0 13%, transparent 15%),
      radial-gradient(circle at 70% 55%, #2b1d16 0 11%, transparent 13%),
      radial-gradient(circle at 38% 74%, #2b1d16 0 10%, transparent 12%),
      #f3eee4;
  }

  /* SEATS WITH A VIEW */
  .view {
    position: relative;
  }

  .view__head {
    display: grid;
    gap: var(--space-md);
    max-width: 44rem;
    margin-bottom: var(--space-xl);
  }

  .view__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }

  .view__grid img {
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  /* Phones and tablets: the wide shot across the top, the two tall ones below. */
  .view__grid .view__wide {
    grid-column: 1 / -1;
    aspect-ratio: 4 / 3;
  }

  /* Laptop up: one row, the wide shot taking the most room. All three share
     the row's height, so the photos line up top and bottom. */
  @media (min-width: 1024px) {
    .view__grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
    .view__grid .view__wide {
      grid-column: auto;
      aspect-ratio: auto;
    }
  }

  .cafe-cta__inner {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 800px) {
    .cafe-cta__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2.5rem, 5vw, 5rem);
    }
  }

  .cafe-cta__photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
    rotate: -2deg;
    box-shadow: 0 24px 50px -28px rgba(10, 37, 64, 0.55);
  }

  .cafe-cta__text {
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
  }

  .cafe-cta h2 {
    max-width: 18ch;
  }
</style>
